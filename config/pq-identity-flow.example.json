{
  "planner": {
    "executable": "REPLACE_NATIVE/pq_identity_flow.exe",
    "sha256": "REPLACE_VERIFIED_SHA256"
  },
  "planner_input_bytes": 2,
  "planner_timeout_seconds": 30,
  "planner_output_bytes": 4096,
  "journal": "REPLACE_JOB/identity-flow.json",
  "bindings": {
    "1": {
      "absent": [
        "REPLACE_PENDING",
        "REPLACE_VAULT"
      ],
      "disjoint_trees": [
        [
          "REPLACE_ORIGINAL",
          "REPLACE_TARGET"
        ],
        [
          "REPLACE_PENDING",
          "REPLACE_ORIGINAL"
        ],
        [
          "REPLACE_PENDING",
          "REPLACE_TARGET"
        ],
        [
          "REPLACE_VAULT",
          "REPLACE_ORIGINAL"
        ],
        [
          "REPLACE_VAULT",
          "REPLACE_TARGET"
        ],
        [
          "REPLACE_JOB",
          "REPLACE_ORIGINAL"
        ],
        [
          "REPLACE_JOB",
          "REPLACE_TARGET"
        ]
      ]
    },
    "2": {
      "destination": "REPLACE_PENDING",
      "whoami": {
        "executable": "REPLACE_WHOAMI",
        "sha256": "REPLACE_VERIFIED_SHA256"
      },
      "owner_sid": "REPLACE_OWNER_SID"
    },
    "3": {
      "tool": {
        "executable": "REPLACE_PQ_OPENSSL",
        "sha256": "REPLACE_VERIFIED_SHA256"
      },
      "argv": [
        "genpkey",
        "-algorithm",
        "ML-KEM-1024",
        "-out",
        "REPLACE_PENDING/recovery.key.pem"
      ],
      "timeout_seconds": 120,
      "max_output_bytes": 1048576,
      "inputs_sha256": {
        "REPLACE_PQ_CRYPTO_DLL": "REPLACE_PQ_CRYPTO_PIN",
        "REPLACE_PQ_SSL_DLL": "REPLACE_PQ_SSL_PIN"
      },
      "clear_environment_prefixes": [
        "OPENSSL_",
        "LD_"
      ],
      "environment": {
        "OPENSSL_CONF": "NUL",
        "OPENSSL_MODULES": "REPLACE_EMPTY_MODULES",
        "OPENSSL_ENGINES": "REPLACE_EMPTY_MODULES"
      }
    },
    "4": {
      "tool": {
        "executable": "REPLACE_PQ_OPENSSL",
        "sha256": "REPLACE_VERIFIED_SHA256"
      },
      "argv": [
        "pkey",
        "-in",
        "REPLACE_PENDING/recovery.key.pem",
        "-pubout",
        "-out",
        "REPLACE_PENDING/recipient.pub.pem"
      ],
      "timeout_seconds": 120,
      "max_output_bytes": 1048576,
      "inputs_sha256": {
        "REPLACE_PQ_CRYPTO_DLL": "REPLACE_PQ_CRYPTO_PIN",
        "REPLACE_PQ_SSL_DLL": "REPLACE_PQ_SSL_PIN"
      },
      "clear_environment_prefixes": [
        "OPENSSL_",
        "LD_"
      ],
      "environment": {
        "OPENSSL_CONF": "NUL",
        "OPENSSL_MODULES": "REPLACE_EMPTY_MODULES",
        "OPENSSL_ENGINES": "REPLACE_EMPTY_MODULES"
      }
    },
    "5": {
      "tool": {
        "executable": "REPLACE_PQ_OPENSSL",
        "sha256": "REPLACE_VERIFIED_SHA256"
      },
      "argv": [
        "pkey",
        "-pubin",
        "-in",
        "REPLACE_PENDING/recipient.pub.pem",
        "-outform",
        "DER",
        "-out",
        "REPLACE_PENDING/recipient.spki.der"
      ],
      "timeout_seconds": 120,
      "max_output_bytes": 1048576,
      "inputs_sha256": {
        "REPLACE_PQ_CRYPTO_DLL": "REPLACE_PQ_CRYPTO_PIN",
        "REPLACE_PQ_SSL_DLL": "REPLACE_PQ_SSL_PIN"
      },
      "clear_environment_prefixes": [
        "OPENSSL_",
        "LD_"
      ],
      "environment": {
        "OPENSSL_CONF": "NUL",
        "OPENSSL_MODULES": "REPLACE_EMPTY_MODULES",
        "OPENSSL_ENGINES": "REPLACE_EMPTY_MODULES"
      }
    },
    "6": {
      "destination": "REPLACE_PENDING/identity.json",
      "fields": {
        "format": "PROJECT-RECOVERY-IDENTITY",
        "project_id": "REPLACE_PROJECT_ID",
        "recipient_scheme": "CMS-ML-KEM-1024-HKDF-SHA256-AES256-WRAP",
        "post_quantum": true
      },
      "files": {
        "certificate": "REPLACE_PENDING/recovery.cert.pem",
        "spki": "REPLACE_PENDING/recipient.spki.der"
      }
    },
    "7": {
      "openssl": {
        "executable": "REPLACE_OPENSSL",
        "sha256": "REPLACE_VERIFIED_SHA256"
      },
      "timeout_seconds": 120,
      "max_log_bytes": 1048576,
      "max_output_bytes": 1073741824,
      "source": "REPLACE_PENDING/identity.json",
      "destination": "REPLACE_PENDING/identity.sig",
      "identity": "REPLACE_SIGNER"
    },
    "8": {
      "openssl": {
        "executable": "REPLACE_OPENSSL",
        "sha256": "REPLACE_VERIFIED_SHA256"
      },
      "timeout_seconds": 120,
      "max_log_bytes": 1048576,
      "max_output_bytes": 1073741824,
      "source": "REPLACE_PENDING/identity.json",
      "signature": "REPLACE_PENDING/identity.sig",
      "public_key": "REPLACE_SIGNER_PUBLIC",
      "trusted_spki_sha256": "REPLACE_SIGNER_PIN"
    },
    "9": {
      "fields": {
        "format": "PROJECT-RECOVERY-IDENTITY",
        "project_id": "REPLACE_PROJECT_ID",
        "recipient_scheme": "CMS-ML-KEM-1024-HKDF-SHA256-AES256-WRAP",
        "post_quantum": true
      },
      "digest_fields": {
        "certificate": "REPLACE_PENDING/recovery.cert.pem",
        "spki": "REPLACE_PENDING/recipient.spki.der"
      },
      "source": "REPLACE_PENDING/identity.json",
      "exact_keys": [
        "format",
        "project_id",
        "recipient_scheme",
        "post_quantum",
        "digests"
      ],
      "exact_digest_keys": [
        "certificate",
        "spki"
      ]
    },
    "10": {
      "source": "REPLACE_PENDING",
      "destination": "REPLACE_VAULT"
    },
    "11": {
      "destination": "REPLACE_JOB/identity-receipt.json",
      "fields": {
        "format": "PROJECT-IDENTITY-INITIALIZATION",
        "status": "PASS",
        "project_id": "REPLACE_PROJECT_ID",
        "production_release_accepted": false
      },
      "files": {
        "identity": "REPLACE_VAULT/identity.json",
        "recipient_spki": "REPLACE_VAULT/recipient.spki.der"
      }
    },
    "12": {
      "tool": {
        "executable": "REPLACE_PQ_OPENSSL",
        "sha256": "REPLACE_VERIFIED_SHA256"
      },
      "argv": [
        "x509",
        "-new",
        "-force_pubkey",
        "REPLACE_PENDING/recipient.pub.pem",
        "-key",
        "REPLACE_SIGNER",
        "-subj",
        "/CN=ProjectPQRecovery",
        "-days",
        "3650",
        "-out",
        "REPLACE_PENDING/recovery.cert.pem"
      ],
      "timeout_seconds": 120,
      "max_output_bytes": 1048576,
      "inputs_sha256": {
        "REPLACE_PQ_CRYPTO_DLL": "REPLACE_PQ_CRYPTO_PIN",
        "REPLACE_PQ_SSL_DLL": "REPLACE_PQ_SSL_PIN"
      },
      "clear_environment_prefixes": [
        "OPENSSL_",
        "LD_"
      ],
      "environment": {
        "OPENSSL_CONF": "NUL",
        "OPENSSL_MODULES": "REPLACE_EMPTY_MODULES",
        "OPENSSL_ENGINES": "REPLACE_EMPTY_MODULES"
      }
    },
    "14": {
      "openssl": {
        "executable": "REPLACE_OPENSSL",
        "sha256": "REPLACE_VERIFIED_SHA256"
      },
      "timeout_seconds": 120,
      "max_log_bytes": 1048576,
      "max_output_bytes": 1073741824,
      "source": "REPLACE_INTEROP_EVIDENCE",
      "signature": "REPLACE_INTEROP_SIGNATURE",
      "public_key": "REPLACE_SIGNER_PUBLIC",
      "trusted_spki_sha256": "REPLACE_SIGNER_PIN"
    },
    "15": {
      "source": "REPLACE_INTEROP_EVIDENCE",
      "fields": {
        "format": "CMS-INTEROPERABILITY-EVIDENCE",
        "status": "PASS",
        "recipient_scheme": "CMS-ML-KEM-1024-HKDF-SHA256-AES256-WRAP"
      },
      "digest_fields": {
        "openssl_executable": "REPLACE_PQ_OPENSSL",
        "libcrypto": "REPLACE_PQ_CRYPTO_DLL",
        "libssl": "REPLACE_PQ_SSL_DLL"
      }
    }
  }
}
