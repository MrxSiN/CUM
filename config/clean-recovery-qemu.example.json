{
  "backend": "qemu",
  "vm": {
    "qemu": {
      "executable": "C:/Program Files/qemu/qemu-system-x86_64.exe",
      "sha256": "REPLACE_WITH_VERIFIED_SHA256"
    },
    "qemu_img": {
      "executable": "C:/Program Files/qemu/qemu-img.exe",
      "sha256": "REPLACE_WITH_VERIFIED_SHA256"
    },
    "disk": {
      "file": "D:/GitHub/CUM/private/images/bytevm.qcow2",
      "sha256": "REPLACE_WITH_VERIFIED_SHA256"
    },
    "scratch_directory": "D:/GitHub/CUM/private/vm-scratch",
    "max_archive_bytes": 134217728,
    "max_packet_bytes": 536870912,
    "max_artifact_bytes": 134217728,
    "boot_timeout_seconds": 300
  },
  "image": "BYTEVM-IMAGE@sha256:REPLACE_WITH_VERIFIED_SHA256",
  "memory_bytes": 4294967296,
  "cpus": 2,
  "user": "1000:1000",
  "pids": 256,
  "environment": {
    "HOME": "/results",
    "WINEDEBUG": "-all",
    "WINEPREFIX": "/results/wine"
  },
  "argv": [
    "/usr/bin/python3.12",
    "-I",
    "/runtime/runtime_entry.py",
    "flow",
    "/bindings/recovery.json",
    "--command",
    "1"
  ],
  "workdir": "/results",
  "timeout_seconds": 300,
  "max_output_bytes": 1048576,
  "mounts": [
    {
      "source": "D:/GitHub/CUM/private/REPLACE_OPERATION/clone",
      "target": "/clone",
      "readonly": true
    },
    {
      "source": "D:/GitHub/CUM/private/REPLACE_OPERATION/runtime",
      "target": "/runtime",
      "readonly": true
    },
    {
      "source": "D:/GitHub/CUM/private/REPLACE_OPERATION/identity",
      "target": "/identity",
      "readonly": true
    },
    {
      "source": "D:/GitHub/CUM/private/REPLACE_OPERATION/trust",
      "target": "/trust",
      "readonly": true
    },
    {
      "source": "D:/GitHub/CUM/private/REPLACE_OPERATION/bindings",
      "target": "/bindings",
      "readonly": true
    },
    {
      "source": "D:/GitHub/CUM/private/REPLACE_OPERATION/results",
      "target": "/results",
      "readonly": false
    }
  ],
  "outputs": [
    {
      "guest": "/results/result.tar",
      "destination": "D:/GitHub/CUM/private/REPLACE_OPERATION/returned/result.tar"
    },
    {
      "guest": "/results/scope.json",
      "destination": "D:/GitHub/CUM/private/REPLACE_OPERATION/returned/scope.json"
    },
    {
      "guest": "/results/receipt.json",
      "destination": "D:/GitHub/CUM/private/REPLACE_OPERATION/returned/receipt.json"
    },
    {
      "guest": "/results/flow.json",
      "destination": "D:/GitHub/CUM/private/REPLACE_OPERATION/returned/flow.json"
    }
  ],
  "policy_file": "D:/GitHub/CUM/private/REPLACE_OPERATION/recovery-policy.json",
  "policy_sha256": "REPLACE_WITH_INDEPENDENTLY_APPROVED_POLICY_SHA256",
  "forbidden_sources": [
    "D:/GitHub/CUM/private/REPLACE_OPERATION/original",
    "D:/GitHub/CUM/private/REPLACE_OPERATION/snapshot",
    "D:/GitHub/CUM/private/REPLACE_OPERATION/reference"
  ]
}
